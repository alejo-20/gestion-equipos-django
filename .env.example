# ============================================================
# Ejemplo de variables de entorno. Copia este archivo como .env
# y reemplaza los valores por los tuyos. NO subas el .env real.
# ============================================================

# Modelo del chatbot. Los modelos Flash funcionan en el plan gratuito.
# La oferta de modelos de Gemini cambia seguido, por eso es configurable.
GEMINI_MODEL=gemini-3.6-flash

# ============================================================
# Base de datos de la app de inventario (Django + microservicios)
# ============================================================
# Django, Node, Java y PHP se conectan a la MISMA base de datos, asi que los
# tres microservicios ven exactamente las mismas filas.
#
# DB_ENGINE: pon "postgres" para usar PostgreSQL. Si lo dejas vacio o no existe,
# Django sigue funcionando con SQLite (db.sqlite3), que es lo que hace el
# proyecto tal como venia.
DB_ENGINE=postgres
DB_NAME=gestion_equipos
DB_USER=gestion
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ============================================================
# Cadena de microservicios para la vista de listado
# ============================================================
# Se prueban en orden y se cae al siguiente si el anterior da timeout, rechaza la
# conexion o responde >= 500. El ultimo recurso es el propio ORM de Django.
NODE_SERVICE_URL=http://localhost:8082
JAVA_SERVICE_URL=http://localhost:8081
PHP_SERVICE_URL=http://localhost:8083
# Segundos de espera por microservicio antes de pasar al siguiente.
TIMEOUT_MICROSERVICIOS=3

# URL base del microservicio FastAPI de mantenimientos.
# Local: http://localhost:8001
# Render: https://tu-microservicio.onrender.com
MICROSERVICIO_URL=http://localhost:8001

# Cadena de conexion a PostgreSQL (Supabase) usada por el microservicio.
DATABASE_URL=postgresql://usuario:password@host:5432/postgres?sslmode=require

# API key de Gemini para el chatbot. Se obtiene gratis en
# https://aistudio.google.com/apikey
# Solo se usa en el servidor Django: nunca se envia al navegador.
GEMINI_API_KEY=
