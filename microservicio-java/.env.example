# Variables de entorno del microservicio Java.
#
# Spring Boot lee variables de entorno del proceso de forma nativa (no necesita
# ningun .env): las pasas con `docker run -e` o las definis en el panel del
# hosting. Este archivo es la documentacion de las que necesita.

# Puerto del servicio. Local: 8081.
PORT=8081

# Conexion a PostgreSQL. Son las MISMAS variables que leen Django (settings.py)
# y el microservicio Node, para poder copiar un unico .env a los cuatro.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_equipos
DB_USER=gestion
# Sin default a proposito: si falta, Postgres rechaza la autenticacion.
DB_PASSWORD=

# Maximo de conexiones del pool HikariCP.
DB_POOL_MAX=5

# Opcionales: pasar argumentos de JVM sin tocar el Dockerfile.
# JAVA_OPTS=-Xmx256m
