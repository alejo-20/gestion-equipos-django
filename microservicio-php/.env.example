# Variables de entorno del microservicio PHP.
#
# index.php las lee con getenv(), que lee el entorno real del proceso: eso es lo
# que inyecta Docker (-e PORT=...) o un hosting de contenedores.

# Puerto del servicio. Local: 8083.
PORT=8083

# Conexion a PostgreSQL. Son las MISMAS variables que leen Django (settings.py),
# el microservicio Node y el de Java, para poder compartir un unico .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_equipos
DB_USER=gestion
# Sin default a proposito: si falta, Postgres rechaza la autenticacion.
DB_PASSWORD=

# Nombre de la tabla compartida. Django la creo con `db_table = 'equipo'`.
EQUIPOS_TABLE=equipo
