PORT=8082

# Cadena de conexion a PostgreSQL. Tiene prioridad sobre las variables DB_* de
# abajo si se define; si se borra, el servicio usa DB_*.
DATABASE_URL=

# Variables sueltas (las mismas que lee Django en settings.py, para poder copiar
# un unico .env a los cuatro proyectos). La clave no tiene default a proposito.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_equipos
DB_USER=gestion
DB_PASSWORD=

# Nombre de la tabla compartida. En este proyecto es `equipo`.
EQUIPOS_TABLE=equipo

# Maximo de conexiones del pool de Postgres.
DB_POOL_MAX=5
